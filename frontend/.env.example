# Usado apenas pelo servidor de desenvolvimento do Vite para encaminhar /api e /uploads.
VITE_API_TARGET=http://127.0.0.1:3001

# Use esta variável quando o frontend estiver publicado separado do backend.
# Se informar só a origem, o frontend acrescenta /api automaticamente.
# Exemplo: VITE_API_URL=http://127.0.0.1:3001
# Exemplo: VITE_API_URL=https://sua-api.com/api
# VITE_API_URL=http://127.0.0.1:3001